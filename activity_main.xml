<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1117"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#161B22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:text="ÖMER TV"
            android:textColor="#00E5FF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCanli"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:text="Canlı TV"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnFilm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:text="Film"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnDizi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:text="Dizi"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnFavori"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:text="Favoriler"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAyarlar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:focusable="true"
            android:text="Ayarlar"
            android:textAllCaps="false"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/channelSidebar"
                android:layout_width="310dp"
                android:layout_height="match_parent"
                android:background="#12161F"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActiveSourceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1C2230"
                    android:padding="8dp"
                    android:text="Hazır | Kumanda / Fare / 1-9 Tuşları"
                    android:textColor="#9FB3C8"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/videoPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:keepScreenOn="true" />

                <TextView
                    android:id="@+id/tvVolumeOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="#CC000000"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:textColor="#00E5FF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0E1117"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kaynak Ekle (M3U / Xtream / MAG / Tek Kanal)"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spSourceType"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="#1E2433" />

                <EditText
                    android:id="@+id/etTitleOrUrl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="#1E2433"
                    android:hint="M3U URL / Xtream Host / MAG Portal veya Tek Kanal Adı"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A99AD"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etExtra1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#1E2433"
                    android:hint="Xtream Kullanıcı Adı / MAG MAC veya Tek Kanal Yayın URL (.m3u8)"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A99AD"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etExtra2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#1E2433"
                    android:hint="Xtream Şifre (isteğe bağlı)"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A99AD"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etRawPlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="#1E2433"
                    android:gravity="top|start"
                    android:hint="M3U liste metnini buraya kopyala-yapıştır yap veya sürükle-bırak..."
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A99AD"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveSource"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="Kaydet ve Listeyi Güncelle"
                    android:textAllCaps="false"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Kayıtlı Listeler ve Tek Kanallar"
                    android:textColor="#00E5FF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSources"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="true" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
